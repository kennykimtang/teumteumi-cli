#!/usr/bin/env node
/**
 * 플러그인이 Bash 도구 PATH에 얹어 주는 실행 파일.
 *
 * 하는 일은 둘뿐이다.
 *   ① 플러그인에 **동봉된** statusline.mjs 로 명령을 넘긴다.
 *   ② 되돌리는 법을 안내할 수 있도록 자기 이름을 `TEUM_ENTRY`로 알려준다.
 *
 * ⚠️ 스크립트를 서버에서 받아오지 않는다. 플러그인 저장소에 그대로 들어 있어야
 *    유저와 마켓플레이스 심사가 **설치 전에** 코드를 볼 수 있다(커뮤니티 마켓플레이스는
 *    승인된 플러그인을 커밋 SHA로 고정한다). `statusline.mjs.sig`로 우리 서명도 확인 가능.
 *    낡음은 설치 뒤 자가 갱신이 해소한다.
 */
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

const here = dirname(fileURLToPath(import.meta.url));
const script = join(here, '..', 'statusline.mjs');

const args = process.argv.slice(2);
const cmd = args[0] && !args[0].startsWith('-') ? args[0] : 'setup';
const rest = args[0] && !args[0].startsWith('-') ? args.slice(1) : args;

const r = spawnSync(process.execPath, [script, cmd, ...rest], {
  stdio: 'inherit',
  env: { ...process.env, TEUM_ENTRY: 'teumteumi' },
});
process.exit(r.status ?? 0);
